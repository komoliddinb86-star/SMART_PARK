DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 1 = SQLite + no-Redis lite mode (Docker'siz, Windows'da eng oson yo'l).
# 0 yoki o'chirilgan = PostgreSQL + Redis (Docker yo'li).
USE_SQLITE=0

POSTGRES_DB=smartpark
POSTGRES_USER=smartpark
POSTGRES_PASSWORD=smartpark
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

CLICK_MERCHANT_ID=
PAYME_MERCHANT_ID=
ESKIZ_SMS_TOKEN=
FIREBASE_CREDENTIALS_PATH=
TELEGRAM_BOT_TOKEN=
